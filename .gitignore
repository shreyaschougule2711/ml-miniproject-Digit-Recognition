# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
env.bak/
venv.bak/

# Environment variables, credentials, and secrets
.env
.env.*
secrets.toml
*.key
*.pem
*.cert
credentials.json
.streamlit/secrets.toml

# Datasets and cache files (large raw downloads)
data/*.npz
data/*.csv
data/*.gz
datasets/
openml/
.cache/
!data/.gitkeep

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo

# Keep serialized models and evaluation results in Git
!models/*.joblib
!models/.gitkeep
!results/**
